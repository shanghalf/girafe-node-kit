{
  "id": "example-upper",
  "name": "Upper case",
  "version": "0.1.0",
  "description": "Turns the text on A into capitals and adds an ending. A minimal plugin to copy from.",
  "hostApi": 0,
  "girafe": ">=0.67.0",
  "icon": "🔠",
  "color": "#7bd389",
  "inputs": { "min": 1, "max": 1 },
  "outputs": ["out"],
  "fields": [
    { "key": "suffix", "type": "text", "label": "Add at the end", "placeholder": "!", "default": "" },
    { "key": "mode", "type": "select", "label": "Case", "options": [["upper", "CAPITALS"], ["lower", "lowercase"]], "default": "upper" }
  ],
  "capabilities": {}
}
